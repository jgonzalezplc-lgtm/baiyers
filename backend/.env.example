SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-key
GEMINI_API_KEY=tu-gemini-key
SERP_API_KEY=tu-serp-key
ANTHROPIC_API_KEY=tu-anthropic-key
ENVIRONMENT=development
# Por defecto sólo se activa automáticamente cuando ENVIRONMENT=production.
# En testing debe quedar explícitamente en false.
CRON_ENABLED=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MCP remoto (OAuth + Streamable HTTP)
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_URL=http://localhost:8000/api/mcp
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver
MCP_ALLOWED_ORIGINS=http://localhost:*

# Fuentes de distribuidores electrónicos (opcionales — si faltan, esa fuente se omite en la búsqueda)
# Mouser: https://www.mouser.com/api-search/ (registro gratis, key inmediata)
MOUSER_API_KEY=

# DigiKey: https://developer.digikey.com/ (crear Organization App, Product Information API v4)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# TME: https://developers.tme.eu/en/ (Token + App Secret)
TME_API_KEY=
TME_API_SECRET=

# Retail/ferretería Chile (Sodimac, Easy, La Sierra, Construmart) — no requieren API key,
# usan endpoints públicos de cada tienda (ver app/services/fuentes/retail_cl.py)

# Google OAuth (Gmail) — alternativa a credentials.json (recomendado en producción)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
